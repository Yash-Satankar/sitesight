# Dependencies & build output
node_modules/
dist/
build/
.turbo/
coverage/

# Env files (keep the example)
.env
.env.*
!.env.example

# Logs & OS junk
*.log
.DS_Store

# SAM spike output
apps/api/spike-out/

# Samples hold real client photos until anonymised. Only the placeholder and the sample BOQs are tracked.
samples/*
!samples/.gitkeep
!samples/boq-demo.json
!samples/boq-demo-residence.json
# Evaluation cases and their small BOQs (the photos they point at stay untracked).
!samples/eval/
samples/eval/*
!samples/eval/*.json

# Deploy secrets (generated passwords etc.), never committed
deploy-secrets.local.txt
*.local.txt

# Vercel project link (meta-proxy)
.vercel

# Client drawings, site photos, voice notes and spreadsheets never go in the repo, wherever they land.
# Only the README screenshots (docs/img/) and the web app's public icons are allowed.
*.pdf
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.heic
*.wav
*.webm
*.m4a
*.mp3
*.ogg
*.xlsx
*.xls
!docs/img/*.png
!apps/web/public/*.png

# Local state, notes and secrets, anywhere (e.g. verify-state.local.json, *.local.md)
*.local.*
meta-support-note*.md
