# Dependencies & build output
node_modules/
dist/
build/
.turbo/
coverage/

# Env files (keep the example)
.env
.env.*
!.env.example

# Logs & OS junk
*.log
.DS_Store

# SAM spike output
apps/api/spike-out/

# Samples hold real client photos until anonymised. Only the placeholder and the sample BOQs are tracked.
samples/*
!samples/.gitkeep
!samples/boq-demo.json
!samples/boq-demo-residence.json
# Evaluation cases and their small BOQs (the photos they point at stay untracked).
!samples/eval/
samples/eval/*
!samples/eval/*.json

# Deploy secrets (generated passwords etc.), never committed
deploy-secrets.local.txt
*.local.txt
