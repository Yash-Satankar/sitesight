{
  "name": "@sitesight/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "sam-spike": "tsx scripts/sam-spike.ts",
    "spark-smoke": "tsx scripts/spark-smoke.ts",
    "test": "vitest run",
    "agent-dry-run": "tsx scripts/agent-dry-run.ts",
    "e2e-smoke": "tsx scripts/e2e-smoke.ts",
    "db:purge-e2e": "tsx scripts/purge-e2e.ts",
    "boq-from-drawings": "tsx scripts/boq-from-drawings.ts",
    "start:prod": "node --import tsx src/prod.ts",
    "eval": "tsx scripts/eval.ts",
    "eval-compare": "tsx scripts/eval-compare.ts",
    "eval-label": "tsx scripts/eval-label.ts",
    "seed-prod": "tsx scripts/seed-prod.ts",
    "prod-photos": "tsx scripts/prod-photos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@meta-sam/parser": "0.1.0",
    "@napi-rs/canvas": "0.1.77",
    "@sitesight/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "openai": "^5.0.0",
    "pdfjs-dist": "5.4.149",
    "pdfkit": "^0.17.0",
    "postgres": "^3.4.5",
    "sharp": "^0.34.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.5",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
