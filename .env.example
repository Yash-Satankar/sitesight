# Meta Model API
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1   # confirm in the Meta dashboard
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# Pricing (USD) — REQUIRED, must be > 0 or the API/worker refuse to start. Copy from the Meta pricing page.
SPARK_INPUT_USD_PER_MTOK=1.25    # Muse Spark standard mode, dev.meta.ai pricing page
SPARK_OUTPUT_USD_PER_MTOK=4.25   # reasoning tokens assumed billed as output
SAM_USD_PER_IMAGE=0.0025

# Agent tunables
MAX_AGENT_STEPS=30            # model turns per run; tool calls do not count
MAX_COST_PER_VISIT_USD=1.50
ASK_BACK_THRESHOLD=0.6
MAX_IMAGE_EDGE_PX=1600
SAM_CONCURRENCY=3            # parallel SAM requests per segment() call
MAX_IMAGES_IN_CONTEXT=3      # images kept in the agent conversation; oldest dropped

# Infra
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sitesight
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sitesight
WEB_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:8787
