# Meta Model API
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1   # confirm in the Meta dashboard
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# Pricing (USD) — REQUIRED, must be > 0 or the API/worker refuse to start. Copy from the Meta pricing page.
SPARK_INPUT_USD_PER_MTOK=1.25    # Muse Spark standard mode, dev.meta.ai pricing page
SPARK_OUTPUT_USD_PER_MTOK=4.25   # reasoning tokens assumed billed as output
SAM_USD_PER_IMAGE=0.0025

# Agent tunables
MAX_AGENT_STEPS=30            # model turns per run; tool calls do not count
MAX_COST_PER_VISIT_USD=1.50
ASK_BACK_THRESHOLD=0.6
MAX_IMAGE_EDGE_PX=1600
VISUAL_ONLY_MAX_CONFIDENCE=0.7
SAM_CONCURRENCY=3            # parallel SAM requests per segment() call
MAX_IMAGES_IN_CONTEXT=3      # images kept in the agent conversation; oldest dropped

# BOQ from drawings (PDF import)
MAX_COST_PER_DRAWING_IMPORT_USD=1.00
DRAWING_MAX_PAGES=40
DRAWING_CONCURRENCY=3        # parallel Spark calls per import

# Infra
NODE_ENV=development         # production on Railway: strict checks at startup, no LAN origins, secure cookies
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sitesight
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sitesight
# Without R2: store photos/masks/reports as files (path relative to the repo root; gitignored). The API then
# serves signed /storage URLs for uploads and downloads. Leave empty to use R2.
STORAGE_LOCAL_DIR=
WEB_ORIGIN=http://localhost:5173
# Dev only: also allow browser origins on the local network (phone testing). Defaults to off when NODE_ENV=production.
ALLOW_LAN_ORIGINS=true
# Public base URL of the API as browsers reach it. Required in production with local storage: signed /storage URLs
# (photos, masks, PDFs) are made absolute with it. Railway (one service): https://<domain>/api. Empty in dev.
PUBLIC_API_URL=

# Public demo
SESSION_SECRET=              # optional: part of the login-cookie key (with DEMO_PASSWORD)
STORAGE_SIGNING_SECRET=      # optional: signs /storage URLs so they survive restarts (else a per-process key)
DEMO_PASSWORD=               # when set, the app asks for this password (signed 7-day cookie); /healthz stays open
DAILY_SPEND_CAP_USD=5        # Meta spend per UTC day (spend ledger: runs, drawing imports, BOQ parses); new runs refused after

# Worker
WORKER_POLL_MS=1000
JOB_MAX_ATTEMPTS=3

# Web (Vite). Leave EMPTY: the web app calls /api, which Vite proxies in dev and the API serves itself in production
# (one service, same origin, so the login cookie works). Nothing secret ever goes in VITE_* variables: they are
# compiled into the public JavaScript.
VITE_API_URL=
