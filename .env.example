# Meta Model API
META_API_KEY=
META_BASE_URL=               # copy from Meta dashboard
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3-1
VOICE_MODEL=muse-voice-transcribe-1.0

# Pricing (USD per 1M tokens) — copy from Meta dashboard, used for the cost guard
SPARK_INPUT_USD_PER_MTOK=0
SPARK_OUTPUT_USD_PER_MTOK=0

# Agent tunables
MAX_AGENT_STEPS=25
MAX_COST_PER_VISIT_USD=1.50
ASK_BACK_THRESHOLD=0.6
MAX_IMAGE_EDGE_PX=1600

# Infra
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sitesight
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sitesight
WEB_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:8787
